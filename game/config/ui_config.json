{
  "_description": "Конфигурация интерфейса - цвета, шрифты, панели, отображение",
  "_version": "1.0.0",

  "display": {
    "window_width": 1920,
    "window_height": 1200,
    "base_width": 1920,
    "base_height": 1200,
    "fps": 60,
    "tile_size": 32
  },

  "fonts": {
    "min_size": 12,
    "default_size": 24,
    "info_size": 20,
    "title_size": 32
  },

  "panels": {
    "overlay_alpha": 180,
    "border_width": 2,
    "padding": 10
  },

  "text_limits": {
    "max_item_name_display": 25,
    "max_stat_value_display": 9999,
    "progress_bar_clamp": true
  },

  "colors": {
    "biomes": {
      "water": [35, 55, 95],
      "sand": [125, 115, 85],
      "plains": [65, 80, 25],
      "hills": [95, 85, 60],
      "forest": [20, 55, 20],
      "mountain": [110, 100, 95],
      "swamp": [45, 65, 35]
    },

    "locations": {
      "city": [169, 169, 169],
      "village": [139, 115, 85],
      "mine": [96, 96, 96],
      "bandit_camp": [178, 34, 34],
      "ruins": [128, 128, 128],
      "magic_school": [138, 43, 226]
    },

    "general": {
      "player": [255, 215, 0],
      "fog": [40, 40, 45],
      "background": [20, 20, 25],
      "text": [255, 255, 255]
