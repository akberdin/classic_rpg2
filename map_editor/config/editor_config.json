{
    "window": {
        "width": 1400,
        "height": 900,
        "title": "Classic RPG - Map Editor",
        "fps": 60
    },
    "map": {
        "default_width": 200,
        "default_height": 200,
        "min_size": 50,
        "max_size": 500,
        "tile_size": 4,
        "min_tile_size": 2,
        "max_tile_size": 20
    },
    "generation": {
        "elevation_scale": 150.0,
        "elevation_octaves": 3,
        "moisture_scale": 120.0,
        "moisture_octaves": 2,
        "water_level": 0.30,
        "beach_level": 0.35,
        "plains_level": 0.50,
        "hills_level": 0.60,
        "mountain_level": 0.75,
        "forest_moisture": 0.55,
        "swamp_moisture": 0.70,
        "temperature_gradient": true,
        "smooth_iterations": 2
    },
    "brushes": {
        "sizes": [1, 3, 5, 10, 15, 20],
        "default_size": 3
    },
    "locations": {
        "capital": {
            "count": 1,
            "color": [255, 0, 255]
        },
        "city": {
            "count_min": 4,
            "count_max": 6,
            "color": [255, 215, 0]
        },
        "village": {
            "count_min": 12,
            "count_max": 18,
            "color": [139, 69, 19]
        },
        "mine": {
            "count_min": 6,
            "count_max": 10,
            "color": [128, 128, 128]
        },
        "bandit_camp": {
            "count_min": 6,
            "count_max": 10,
            "color": [139, 0, 0]
        },
        "ruins": {
            "count_min": 8,
            "count_max": 12,
            "color": [105, 105, 105]
        },
        "magic_school": {
            "count": 1,
            "color": [148, 0, 211]
        },
        "warrior_academy": {
            "count": 1,
            "color": [255, 140, 0]
        },
        "secret_camp": {
            "count": 1,
            "color": [0, 100, 0]
        },
        "spawn_wolf": {
            "color": [150, 75, 75]
        },
        "spawn_bear": {
            "color": [120, 80, 50]
        },
        "spawn_deer": {
            "color": [210, 180, 140]
        }
    },
    "biomes": {
        "water": {
            "color": [65, 105, 225],
            "passable": false
        },
        "sand": {
            "color": [238, 214, 175],
            "passable": true
        },
        "plains": {
            "color": [124, 252, 0],
            "passable": true
        },
        "forest": {
            "color": [34, 139, 34],
            "passable": true
        },
        "hills": {
            "color": [154, 205, 50],
            "passable": true
        },
        "mountain": {
            "color": [139, 137, 137],
            "passable": true
        },
        "swamp": {
            "color": [85, 107, 47],
            "passable": true
        }
    },
    "ui": {
        "sidebar_width": 280,
        "toolbar_height": 50,
        "panel_color": [45, 45, 48],
        "button_color": [62, 62, 66],
        "button_hover_color": [80, 80, 85],
        "button_active_color": [0, 122, 204],
        "text_color": [255, 255, 255],
        "border_color": [70, 70, 75]
    }
